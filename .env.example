# =========================================================
# ORIONIS - Environment Configuration
# =========================================================

# =========================
# Application
# =========================
ENV=dev
LOG_LEVEL=INFO
GATEWAY_TIMEOUT_S=90
NGROK_AUTHTOKEN=COPY_YOUR_NGROK_AUTHTOKEN_HERE
# =========================
# PostgreSQL
# =========================
POSTGRES_DB=orionis
POSTGRES_USER=orionis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =========================
# Public Base URL (ngrok / domaine)
# =========================
PUBLIC_BASE_URL=https://your-public-domain-or-ngrok-url

# =========================
# Text2SQL Flags (dev/tests)
# =========================
TEXT2SQL_SOFT_SCHEMA_FAIL=0
TEXT2SQL_STUB_LLM=0
ENFORCE_LIMIT_ON_SELECT=0

# =========================
# LLM Configuration (OpenAI)
# =========================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TIMEOUT=20
OPENAI_MAX_TOKENS=400

# =========================
# Twilio WhatsApp
# =========================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# =========================
# Audit UI
# =========================
AUDIT_ADMIN_USER=admin
AUDIT_ADMIN_PASS=admin

# =========================
# Test UI
# =========================
TEST_UI_ACTOR_ID=whatsapp:+33000000000

# =========================
# Writer Configuration
# =========================
WRITER_TIMEOUT_S=12
WRITER_MAX_ITEMS=10
WRITER_MAX_TEXT_CHARS=1200

# =========================
# SQL Guard / Executor
# =========================
GUARD_AUTO_LIMIT=0
GUARD_MAX_ROWS=200
DB_STATEMENT_TIMEOUT_MS=5000
MAX_RETURN_ROWS=200

# =========================
# Audit Service
# =========================
AUDIT_TABLE_NAME=audit_service_event
AUDIT_AUTO_MIGRATE=1
